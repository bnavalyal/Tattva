# Member 2: Sarvam Node.js API Bridge URL (leave blank to use built-in Local Crucible Demo Engine)
VITE_API_BASE_URL=http://localhost:3001

# Member 3: Supabase Project Credentials (optional for local demo; required for live WalletTransactions ledger)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to force Local Demo Engine even if API URL is configured
VITE_USE_MOCK_ENGINE=true
